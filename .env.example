# =========================================================================
# RAFAY HACKING LAB — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for production deployment. Never commit real credentials!
# =========================================================================

# 1. GOOGLE GEMINI AI API (Server-side Gemini 3.8 Flash model support)
# Injected at runtime by AI Studio user secrets panel or environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. APPLICATION RUNTIME & URL
APP_URL="MY_APP_URL"
PORT="3000"

# 3. SUPABASE POSTGRESQL DATABASE (Phase 1 Persistence & Auth Sync)
# Obtain these from your Supabase Project Settings -> API & Database URL
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# 4. EXTERNAL CLOUD LAB CONTAINER PROVIDER ADAPTER (Phase 2 Real Cloud Labs)
# Supported options: "aws-ecs" | "gcp-cloud-run" | "fly-io" | "portainer" | "kubernetes"
CLOUD_LAB_PROVIDER="portainer"
CLOUD_LAB_API_URL="https://cloud-lab-gateway.yourdomain.com/api"
CLOUD_LAB_API_KEY="your-cloud-lab-api-secret-key"

# 5. MODE B CLOUD REMOTE BROWSER TERMINAL WEBSOCKET (Phase 3 Terminal Adapter)
VITE_CLOUD_TERMINAL_WS_URL="wss://terminal-gateway.yourdomain.com/ws"

# 6. OPTIONAL KALI BRIDGE COMPANION (Disabled by default)
# VITE_KALI_BRIDGE_URL="http://127.0.0.1:4444"
